{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-energy-archive/open-energy-archive/schema/document.schema.json",
  "title": "Open Energy Archive – Dokument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "doc_type",
    "jurisdiction",
    "issuer",
    "date",
    "status",
    "languages",
    "topics",
    "summary_de",
    "source_url",
    "rights",
    "added",
    "last_checked"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}-[a-z0-9-]+$",
      "description": "Stabile ID: <jurisdiction>-<kurzbezeichnung>. Muss dem Dateinamen entsprechen und darf nie geändert werden."
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "title_en": {
      "type": "string"
    },
    "short_title": {
      "type": "string"
    },
    "doc_type": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "subdivision": {
      "type": "string",
      "description": "Kanton / Bundesland, z. B. CH-ZH, DE-BY"
    },
    "issuer": {
      "type": "string"
    },
    "reference": {
      "type": "string",
      "description": "SR-Nr., Geschäfts-Nr., Aktenzeichen, CELEX-Nr. usw."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Erlass-, Entscheid- oder Publikationsdatum"
    },
    "date_precision": {
      "enum": [
        "day",
        "month",
        "year"
      ]
    },
    "status": {
      "type": "string"
    },
    "status_note": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "summary_de": {
      "type": "string",
      "minLength": 40,
      "description": "Neutrale Zusammenfassung in eigenen Worten, 1–3 Sätze"
    },
    "summary_en": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "alternate_urls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "file": {
      "type": "string",
      "description": "Pfad zu gespiegelter Datei unter files/ – nur wenn rights.mirror_allowed = true"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mirror_allowed"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "description": "SPDX-ID, z. B. CC-BY-4.0"
        },
        "permission_ref": {
          "type": "string",
          "description": "Verweis auf dokumentierte Freigabe (docs/permissions/…)"
        },
        "mirror_allowed": {
          "type": "boolean"
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "string"
    },
    "added": {
      "type": "string",
      "format": "date"
    },
    "last_checked": {
      "type": "string",
      "format": "date"
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content": {
      "type": "string",
      "description": "Pfad zu eigenem Markdown-Volltext unter content/ (nur bei rights.status open_license); wird auf der Website angezeigt und durchsuchbar"
    },
    "downloads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "path"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "version": {
      "type": "string",
      "description": "Version eigener Inhalte, z. B. 1.0"
    }
  }
}